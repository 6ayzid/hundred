# হান্ড্রেট (Hundred) — Environment Configuration
# Copy this file to .env.local and fill in your credentials.
# Without these values, the app runs in local single-player-with-bots fallback mode.

# Supabase Realtime (Public client-safe keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# LiveKit Voice Comms (WebSocket URL is public; API key/secret are server-only)
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
